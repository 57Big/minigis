# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/minigis

# CORS — vergul bilan ajratib bir nechta origin yozish mumkin
CLIENT_ORIGIN=http://localhost:5173

# OpenAI (AI joy tahlili uchun)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# AI rate limit (dqq/IP)
AI_RATE_LIMIT_PER_MIN=20

# Nominatim user agent (Usage Policy talabi)
NOMINATIM_USER_AGENT=miniGIS-BMI/1.0 (academic project)
